rules_version = '2';

// InquireHub Phase 5 security rules.
// Deploy: firebase deploy --only firestore:rules
// Mirror policy helpers: frontend/src/lib/accessControl.js

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function userRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid()))
        ? userDoc().role
        : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isVendor() {
      return userRole() == 'vendor' || isAdmin();
    }

    function shopIds() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid()))
        ? userDoc().get('shopIds', [])
        : [];
    }

    function isShopMember(shopId) {
      return shopId in shopIds()
        || (exists(/databases/$(database)/documents/shops/$(shopId))
          && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == uid());
    }

    function shopIsSuspended(shopId) {
      return shopId != ''
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.get('suspended', false) == true;
    }

    // Members may update profile + response metrics — not verify/suspend.
    function shopMemberSafeUpdate() {
      return request.resource.data.verified == resource.data.verified
        && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
        && request.resource.data.get('suspendedReason', '') == resource.data.get('suspendedReason', '');
    }

    // —— users ——
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow create: if signedIn()
        && uid() == userId
        && request.resource.data.uid == userId
        && request.resource.data.role in ['buyer', 'vendor']
        && !(request.resource.data.role == 'admin');
      allow update: if signedIn() && (
        isAdmin()
        || (
          uid() == userId
          && request.resource.data.role != 'admin'
          && (
            request.resource.data.role in ['buyer', 'vendor']
          )
        )
      );
      allow delete: if false;
    }

    // —— catalog ——
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      // Hidden listings are admin-only to read.
      allow read: if resource.data.get('hidden', false) != true || isAdmin();
      allow create: if signedIn() && (
        isAdmin()
        || (
          isVendor()
          && request.resource.data.keys().hasAny(['shopId', 'shop_id'])
          && isShopMember(
            request.resource.data.get('shopId', request.resource.data.get('shop_id', ''))
          )
          && !shopIsSuspended(
            request.resource.data.get('shopId', request.resource.data.get('shop_id', ''))
          )
          && request.resource.data.get('hidden', false) == false
        )
      );
      allow update: if signedIn() && (
        isAdmin()
        || (
          isVendor()
          && isShopMember(
            resource.data.get('shopId', resource.data.get('shop_id', ''))
          )
          && !shopIsSuspended(
            resource.data.get('shopId', resource.data.get('shop_id', ''))
          )
          // Vendors cannot toggle hidden themselves.
          && request.resource.data.get('hidden', false) == resource.data.get('hidden', false)
        )
      );
      allow delete: if signedIn() && (
        isAdmin()
        || (
          isVendor()
          && isShopMember(
            resource.data.get('shopId', resource.data.get('shop_id', ''))
          )
        )
      );
    }

    match /shops/{shopId} {
      allow read: if true;
      // Vendors create shops for themselves; admins may create for an applicant (waitlist approve).
      allow create: if signedIn()
        && request.resource.data.verified == false
        && request.resource.data.get('suspended', false) == false
        && (
          isAdmin()
          || request.resource.data.ownerUid == uid()
        );
      allow update: if signedIn() && (
        isAdmin()
        || (
          (resource.data.ownerUid == uid() || isShopMember(shopId))
          && shopMemberSafeUpdate()
        )
      );
      allow delete: if isAdmin();
    }

    // —— moderation reports (Phase 5) ——
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.reporterUid == uid()
        && request.resource.data.status == 'open';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // —— vendor onboarding waitlist (owner admin) ——
    match /vendorWaitlist/{id} {
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && (
          !('applicantUid' in request.resource.data)
          || request.resource.data.applicantUid == uid()
        );
      allow read, update, delete: if isAdmin();
    }

    // —— site config (public read, admin write) ——
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // —— private inquiry threads ——
    match /inquiries/{inquiryId} {
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.buyerUid == uid()
        || isShopMember(resource.data.shopId)
      );
      allow create: if signedIn()
        && request.resource.data.buyerUid == uid();
      allow update: if signedIn() && (
        isAdmin()
        || (
          (resource.data.buyerUid == uid() || isShopMember(resource.data.shopId))
          && request.resource.data.get('hidden', false) == resource.data.get('hidden', false)
        )
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.buyerUid == uid()
          || isShopMember(
            get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.shopId
          )
        );
        allow create: if signedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.buyerUid == uid()
          || isShopMember(
            get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.shopId
          )
        );
        allow update, delete: if isAdmin();
      }
    }
  }
}
