# Copy this file to `.env` and fill in values from your Firebase project settings.
# https://console.firebase.google.com → Project settings → Your apps

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: backend base URL for inquiry chat (POST /inquiries, GET/POST …/messages).
# Leave unset to use Firestore (Phase 3 default).
# VITE_INQUIRY_API_BASE=https://api.example.com

# DEV only: force localStorage inquiry demo (never used in production builds).
# VITE_INQUIRY_DEMO_LOCAL=true

# Phase 2: enable Google and/or Email/Password in Firebase Console → Authentication.
# Deploy: firebase deploy --only firestore:rules,firestore:indexes,storage
